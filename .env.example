OIDC_JWKS_URL=http://localhost:4000/jwks
OIDC_ISSUER=http://localhost:4000

# Confidential token-exchange proxy (POST /token).
OIDC_TOKEN_URL=http://localhost:4000/token

# Fallback client, used when a redirect_uri is not in OIDC_TOKEN_CLIENTS below.
OIDC_CLIENT_ID=react-login-confidential
OIDC_CLIENT_SECRET=react-login-dev-secret-do-not-use-in-prod

# Multi-client registry: one instance serves both demo apps. JSON keyed by
# redirect_uri (the POST /token payload carries no client_id).
OIDC_TOKEN_CLIENTS={"http://localhost:5173/callback":{"client_id":"react-login-confidential","client_secret":"react-login-dev-secret-do-not-use-in-prod"},"http://localhost:3000/callback":{"client_id":"next-login-confidential","client_secret":"next-login-dev-secret-do-not-use-in-prod"}}
